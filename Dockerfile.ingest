FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
      pdfplumber \
      yfinance \
      google-api-python-client \
      google-auth \
      google-auth-oauthlib \
      fastapi \
      uvicorn \
      python-multipart

COPY tx_store.py pdf_extract.py parse_rules.py statement_rules.py import_txs.py fetch_email.py auth_gmail.py get_prices.py server.py parser_service.py quotes_service.py ./

CMD ["python", "import_txs.py"]
