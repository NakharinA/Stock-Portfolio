DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio
PORT=3000
FRONTEND_URL=https://port.pueyleng.com

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Must decode to exactly 32 bytes: openssl rand -base64 32
ENCRYPTION_KEY=

# Google Cloud Console > Credentials > OAuth client ID > Web application.
# Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://port-api.pueyleng.com/api/auth/google/callback
