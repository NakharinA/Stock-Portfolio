// Every table that holds portfolio data carries a userId and is only ever queried through
// it: this is a shared instance, and one person's trades must never be reachable from
// another person's session. Market data (prices, year-end closes) is deliberately global,
// because a closing price is a fact about the market, not about a user.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps the connection URL out of the schema: migrations read it from
// prisma.config.ts, and the client gets it through a driver adapter (see prisma.service.ts).
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  googleSub String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  googleGrant     GoogleGrant?
  brokerSetting   BrokerSetting?
  transactions    Transaction[]
  priceOverrides  PriceOverride[]
  importJobs      ImportJob[]
  sourceDocuments SourceDocument[]

  @@map("users")
}

// The Gmail refresh token that lets the importer read this user's confirmation notes.
// Stored encrypted: the database is not a place a long-lived mailbox grant belongs in
// plaintext, and a dump of this table would otherwise hand over every user's inbox.
model GoogleGrant {
  id                String   @id @default(uuid())
  userId            String   @unique
  refreshTokenEnc   String
  scope             String
  connectedAt       DateTime @default(now())
  lastRefreshedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_grants")
}

// Per-user broker settings: the password on the confirmation PDFs (encrypted, same
// reasoning as above) and the Gmail query that selects them.
model BrokerSetting {
  id             String  @id @default(uuid())
  userId         String  @unique
  pdfPasswordEnc String?
  gmailQuery     String  @default("subject:(Dime \"Confirmation Note\") has:attachment filename:pdf")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("broker_settings")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
}

enum TransactionSource {
  // Parsed from a broker confirmation note.
  CONFIRMATION_NOTE
  // Entered by the user, or carried over from a document the importer cannot read.
  MANUAL
}

// Buys and sells use qty + price; dividends use amount. They are separate columns rather
// than one overloaded field because overloading it is what made an earlier version of this
// project record dividends as if they were share counts.
model Transaction {
  id         String            @id @default(uuid())
  userId     String
  externalId String
  tradeDate  DateTime          @db.Date
  ticker     String
  type       TransactionType
  source     TransactionSource @default(CONFIRMATION_NOTE)

  // Seven decimals because the broker sells fractional shares and prints seven.
  qty    Decimal? @db.Decimal(20, 7)
  price  Decimal? @db.Decimal(20, 6)
  amount Decimal? @db.Decimal(20, 4)
  fee    Decimal  @default(0) @db.Decimal(20, 4)

  orderId    String?
  sourceFile String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // externalId is a hash of the trade itself, so re-importing the same note is a no-op.
  @@unique([userId, externalId])
  @@index([userId, tradeDate])
  @@index([userId, ticker])
  @@map("transactions")
}

// Latest market price per ticker. Global: this is what the market says, not what a user says.
model Price {
  ticker    String   @id
  price     Decimal  @db.Decimal(20, 6)
  fetchedAt DateTime

  @@map("prices")
}

// A price the user typed in themselves, which always wins over the fetched one for them.
model PriceOverride {
  id     String  @id @default(uuid())
  userId String
  ticker String
  price  Decimal @db.Decimal(20, 6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@map("price_overrides")
}

model YearEndPrice {
  ticker String
  year   Int
  price  Decimal @db.Decimal(20, 6)

  @@id([ticker, year])
  @@map("year_end_prices")
}

enum JobKind {
  SYNC
  PRICES
}

enum JobState {
  RUNNING
  DONE
  ERROR
}

model ImportJob {
  id         String    @id @default(uuid())
  userId     String
  kind       JobKind
  state      JobState  @default(RUNNING)
  log        String[]  @default([])
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("import_jobs")
}

// One row per confirmation note already seen, so a sync only downloads and parses what is
// new. Keyed by the Gmail message and the attachment name rather than by content, so a
// re-sent mail does not re-enter the pipeline.
model SourceDocument {
  id             String   @id @default(uuid())
  userId         String
  gmailMessageId String
  filename       String
  sha256         String
  rowCount       Int      @default(0)
  importedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId, filename])
  @@map("source_documents")
}
